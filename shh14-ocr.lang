[zh-cn]
name = "文档文字识别"
auth = "shh"
descript = "把 TNAS 上的文档转成可检索文本。对 PDF 直接读取文件结构——交叉引用表、页内容流、FlateDecode 解压、文本显示操作符与 ToUnicode 字符映射——在没有任何外部程序的情况下提取内嵌文字层，输出 TXT、Markdown 或 JSON，并给出每页字符数，让你一眼看出哪些页没有文字层、需要真正的 OCR。批量模式可处理整个目录树并建立本地 SQLite 索引，支持关键词检索。图片文件可读出尺寸与 EXIF 元数据。全部在本机离线完成。若系统上存在 tesseract，或管理员配置了远程 OCR 接口，图片 OCR 可作为附加能力启用。"
release_note = "1. 首次发布。"
important = "PDF 文字提取完全离线、不需要任何外部程序。图片 OCR 需要 tesseract 或已配置的接口。"

[zh-hk]
name = "文件文字辨識"
auth = "shh"
descript = "把 TNAS 上的文件轉成可檢索文字。對 PDF 直接讀取檔案結構——交叉參照表、頁內容流、FlateDecode 解壓、文字顯示運算子與 ToUnicode 字元映射——在沒有任何外部程式的情況下提取內嵌文字層，輸出 TXT、Markdown 或 JSON，並給出每頁字元數，讓你一眼看出哪些頁沒有文字層、需要真正的 OCR。批次模式可處理整個目錄樹並建立本機 SQLite 索引，支援關鍵字檢索。圖片檔案可讀出尺寸與 EXIF 中繼資料。全部在本機離線完成。若系統上存在 tesseract，或管理員設定了遠端 OCR 介面，圖片 OCR 可作為附加能力啟用。"
release_note = "1. 首次發佈。"
important = "PDF 文字提取完全離線、不需要任何外部程式。圖片 OCR 需要 tesseract 或已設定的介面。"

[en-us]
name = "Document OCR"
auth = "shh"
descript = "Turns documents on your TNAS into searchable text. For PDFs it reads the structure directly - xref table, content streams, FlateDecode and ToUnicode maps - and extracts the embedded text layer with no external program, writing TXT, Markdown or JSON plus a per-page character count showing which pages have no text layer. Batch mode covers a folder tree and builds a searchable local index. Images yield dimensions and EXIF. Image OCR needs tesseract or a configured endpoint."
release_note = "1. Initial release."
important = "PDF text extraction works fully offline with no external program. Image OCR requires tesseract or a configured endpoint."

[fr-fr]
name = "OCR de documents"
auth = "shh"
descript = "Convertit les documents du TNAS en texte interrogeable. Pour les PDF, il lit la structure du fichier et extrait la couche de texte sans programme externe, en TXT, Markdown ou JSON, avec le nombre de caractères par page : on voit ainsi quelles pages exigent une vraie OCR. Le mode par lot parcourt une arborescence et bâtit un index SQLite local avec recherche par mot-clé. Les images livrent dimensions et EXIF. Tout se fait hors ligne. L'OCR d'images est une option (tesseract ou service distant configuré)."
release_note = "1. Première version."
important = "L'extraction du texte des PDF est entièrement hors ligne et sans programme externe. L'OCR d'images nécessite tesseract ou un service configuré."

[de-de]
name = "Dokumenten-OCR"
auth = "shh"
descript = "Wandelt Dokumente auf Ihrem TNAS in durchsuchbaren Text um. Bei PDFs analysiert es die Dateistruktur selbst und zieht die Textebene ohne jedes externe Programm heraus — als TXT, Markdown oder JSON, mit Zeichenzahl pro Seite, sodass Sie sehen, welche Seiten echtes OCR brauchen. Der Stapelmodus läuft über einen ganzen Baum und baut einen lokalen SQLite-Index mit Stichwortsuche. Bilder liefern Abmessungen und EXIF. Alles läuft offline. Bild-OCR ist optional (vorhandenes tesseract oder eingerichteter Dienst)."
release_note = "1. Erstveröffentlichung."
important = "Die Textextraktion aus PDF läuft völlig offline und ohne externe Programme. Bild-OCR benötigt tesseract oder einen eingerichteten Dienst."

[it-it]
name = "OCR documenti"
auth = "shh"
descript = "Converte i documenti del TNAS in testo ricercabile. Per i PDF analizza la struttura del file ed estrae il livello di testo senza programmi esterni, in TXT, Markdown o JSON, con il numero di caratteri per pagina: si vede subito quali pagine richiedono un vero OCR. La modalità in blocco percorre un'intera struttura e crea un indice SQLite locale con ricerca per parola chiave. Le immagini danno dimensioni ed EXIF. Tutto in locale, offline. L'OCR delle immagini è opzionale (tesseract o servizio configurato)."
release_note = "1. Prima versione."
important = "L'estrazione del testo dai PDF è del tutto offline e senza programmi esterni. L'OCR delle immagini richiede tesseract o un servizio configurato."

[es-es]
name = "OCR de documentos"
auth = "shh"
descript = "Convierte los documentos de tu TNAS en texto consultable. En los PDF analiza la estructura del archivo y extrae la capa de texto sin programas externos, en TXT, Markdown o JSON, con el número de caracteres por página: así ves qué páginas necesitan un OCR real. El modo por lotes recorre todo un árbol y crea un índice SQLite local con búsqueda por palabra clave. Las imágenes aportan dimensiones y EXIF. Todo en local, sin conexión. El OCR de imágenes es opcional (tesseract presente o servicio configurado)."
release_note = "1. Primera versión."
important = "La extracción de texto de los PDF es totalmente local y sin programas externos. El OCR de imágenes requiere tesseract o un servicio configurado."

[hu-hu]
name = "Dokumentum-OCR"
auth = "shh"
descript = "A TNAS dokumentumait kereshető szöveggé alakítja. PDF esetén magát a fájlszerkezetet elemzi, és külső program nélkül nyeri ki a szövegréteget TXT, Markdown vagy JSON formában, oldalankénti karakterszámmal: így látszik, mely oldalakhoz kell valódi OCR. A kötegelt mód egy egész fáát bejár, és helyi SQLite-indexet épít kulcsszókereséssel. A képek méretet és EXIF-adatokat adnak. Minden offline. A képek OCR-je opcionális (meglévő tesseract vagy beállított szolgáltatás)."
release_note = "1. Első kiadás."
important = "A PDF-szöveg kinyerése teljesen offline, külső program nélkül történik. A képek OCR-jéhez tesseract vagy beállított szolgáltatás kell."

[ja-jp]
name = "文書OCR"
auth = "shh"
descript = "TNAS 上の文書を検索できるテキストに変換します。PDF はファイル構造そのものを解析し、外部プログラムなしでテキスト層を取り出して TXT・Markdown・JSON で出力、ページごとの文字数も示すので、どのページに本物の OCR が必要かが分かります。バッチモードはフォルダー全体を走査し、キーワード検索できるローカル SQLite 索引を作成します。画像は寸法と EXIF を読み取ります。すべてオフラインです。画像 OCR は任意機能で、tesseract があるか遠隔サービスを設定した場合に有効になります。"
release_note = "1. 初回リリース。"
important = "PDF の文字抽出は完全にオフラインで、外部プログラムは不要です。画像 OCR には tesseract または設定済みサービスが必要です。"

[ko-kr]
name = "문서 OCR"
auth = "shh"
descript = "TNAS의 문서를 검색 가능한 텍스트로 바꿉니다. PDF는 파일 구조 자체를 분석해 외부 프로그램 없이 텍스트 레이어를 추출하고 TXT·Markdown·JSON으로 출력하며, 페이지별 글자 수도 보여주므로 어느 페이지에 실제 OCR이 필요한지 알 수 있습니다. 일괄 모드는 폴더 트리 전체를 훑어 키워드 검색이 가능한 로컬 SQLite 색인을 만듭니다. 이미지는 크기와 EXIF를 읽습니다. 모든 처리는 오프라인입니다. 이미지 OCR은 선택 기능으로, tesseract가 있거나 원격 서비스를 설정한 경우 켤 수 있습니다."
release_note = "1. 최초 릴리스."
important = "PDF 텍스트 추출은 완전히 오프라인이며 외부 프로그램이 필요 없습니다. 이미지 OCR에는 tesseract 또는 설정된 서비스가 필요합니다."

[pl-pl]
name = "OCR dokumentów"
auth = "shh"
descript = "Zamienia dokumenty na TNAS w przeszukiwalny tekst. W plikach PDF analizuje samą strukturę pliku i wydobywa warstwę tekstową bez żadnego zewnętrznego programu, do TXT, Markdown lub JSON, z liczbą znaków na stronę — od razu widać, które strony wymagają prawdziwego OCR. Tryb wsadowy przechodzi całe drzewo i buduje lokalny indeks SQLite z wyszukiwaniem po słowach kluczowych. Obrazy dają wymiary i EXIF. Wszystko lokalnie, offline. OCR obrazów jest opcjonalny (tesseract lub skonfigurowana usługa)."
release_note = "1. Pierwsze wydanie."
important = "Wyodrębnianie tekstu z PDF jest w pełni lokalne i nie wymaga zewnętrznych programów. OCR obrazów wymaga tesseract lub skonfigurowanej usługi."

[ru-ru]
name = "OCR документов"
auth = "shh"
descript = "Превращает документы на TNAS в текст с поиском. В PDF разбирает саму структуру файла и извлекает текстовый слой без внешних программ — в TXT, Markdown или JSON, с числом символов по страницам: сразу видно, каким страницам нужен настоящий OCR. Пакетный режим обходит всё дерево и строит локальный индекс SQLite с поиском по ключевым словам. Изображения дают размеры и EXIF. Всё работает офлайн. OCR изображений необязателен (есть tesseract или настроен сервис)."
release_note = "1. Первый выпуск."
important = "Извлечение текста из PDF полностью офлайн и не требует внешних программ. Для OCR изображений нужен tesseract или настроенный сервис."

[tr-tr]
name = "Belge OCR"
auth = "shh"
descript = "TNAS belgelerini aranabilir metne dönüştürür. PDF dosyalarında yapıyı doğrudan çözümleyip metin katmanını hiçbir harici program olmadan çıkarır; TXT, Markdown veya JSON olarak verir ve sayfa başına karakter sayısını gösterir, böylece hangi sayfaların gerçek OCR gerektirdiği görülür. Toplu kip tüm klasör ağacını tarayıp anahtar sözcük aramalı yerel bir SQLite dizini kurar. Görseller boyut ve EXIF bilgisi verir. Her şey çevrimdışıdır. Görsel OCR isteğe bağlıdır (tesseract varsa veya uzak servis ayarlıysa)."
release_note = "1. İlk sürüm."
important = "PDF metin çıkarma tamamen çevrimdışıdır ve harici program gerektirmez. Görsel OCR için tesseract veya ayarlı bir servis gerekir."

[pt-pt]
name = "OCR de documentos"
auth = "shh"
descript = "Converte os documentos do TNAS em texto pesquisável. Nos PDF analisa a própria estrutura do ficheiro e extrai a camada de texto sem qualquer programa externo, em TXT, Markdown ou JSON, com o número de caracteres por página: vê-se logo que páginas exigem um OCR verdadeiro. O modo em lote percorre toda a árvore e cria um índice SQLite local com pesquisa por palavra-chave. As imagens dão dimensões e EXIF. Tudo localmente, sem rede. O OCR de imagens é opcional (tesseract presente ou serviço configurado)."
release_note = "1. Primeira edição."
important = "A extração de texto dos PDF é totalmente local e sem programas externos. O OCR de imagens requer tesseract ou um serviço configurado."
